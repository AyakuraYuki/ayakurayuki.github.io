---
import '../styles/site.css';
interface Props { title?: string; description?: string; article?: boolean; }
const { title, description = 'Ayakura Yuki 的个人文章档案。技术笔记、项目与生活记录。', article = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — Ayakura Yuki 的小窝` : 'Ayakura Yuki 的小窝 · 个人档案'}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#e8e5e1" />
    <meta property="og:title" content={title ?? 'Ayakura Yuki 的小窝'} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <slot name="head" />
  </head>
  <body class:list={[article && 'article-page']}>
    <a class="skip-link" href="#page-main">跳转到正文</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Ayakura Yuki 的小窝首页">
        <strong>AYAKURA YUKI</strong>
        <span>PERSONAL INFORMATION ARCHIVE</span>
        <span class="wordmark-last">ANALYSIS <b>OS</b></span>
      </a>
      <nav class="top-nav" aria-label="主导航">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>文章索引 <span>↗</span></a>
        <a href="/migration/">迁移进度 <span>01 / 04</span></a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <span>© 2017–2026 AYAKURA YUKI</span>
      <span class="preview-label"><i></i> 迁移预览 · 非正式站点</span>
      <a href="/fonts/MiSans-license.pdf">MiSans 字体许可 ↗</a>
    </footer>
  </body>
</html>
