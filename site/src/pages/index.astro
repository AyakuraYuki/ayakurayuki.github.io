---
import { getCollection, render } from 'astro:content';
import { robots, siteIdentity } from '../lib/site-meta';
import type { ArchivePost } from '../archive/catalog';
const entries = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date) || a.data.slug.localeCompare(b.data.slug));
const posts: ArchivePost[] = await Promise.all(entries.map(async entry => {
  const { headings } = await render(entry);
  const p = entry.data;
  return { id: entry.id, slug: p.slug, title: p.title, description: p.description, dateLabel: p.dateLabel,
    categories: p.categories, tags: p.tags, href: p.href, readingMinutes: p.readingMinutes,
    headings: headings.map(h => ({ depth: h.depth, slug: h.slug, text: h.text })) };
}));
const payload = JSON.stringify(posts).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#e8e5e1" />
    <meta name="robots" content={robots} />
    <meta name="description" content="Ayakura Yuki 的文章档案：通过五列三维档案浏览技术笔记、项目和生活记录。" />
    <title>Ayakura Yuki 的小窝 · 三维文章档案</title>
    <meta property="og:title" content={siteIdentity.title} />
    <meta property="og:description" content={siteIdentity.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL('/', Astro.site)} />
    <meta property="og:site_name" content={siteIdentity.title} />
    <link rel="alternate" type="application/rss+xml" title={siteIdentity.title} href="/index.xml" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={new URL('/', Astro.site)} />
  </head>
  <body>
    <main id="viewport"><div id="stage"></div></main>
    <section id="archive-fallback" aria-label="普通文章阅读入口">
      <h1>Ayakura Yuki 的文章档案</h1>
      <p>正在连接三维档案库；无需等待，也可以直接阅读文章。</p>
      <a href="/posts/">进入普通文章索引 →</a>
      <ul>{posts.map(post => <li><a href={post.href}>{post.title}</a></li>)}</ul>
    </section>
    <a class="archive-plain-link" href="/posts/">普通文章索引 ↗</a>
    <script is:inline id="blog-archive-data" type="application/json" set:html={payload}></script>
    <script>
      const fallback = document.getElementById('archive-fallback')!;
      const viewport = document.getElementById('viewport')!;
      const fail = () => {
        fallback.hidden = false; viewport.hidden = true;
        document.body.classList.add('archive-failed');
        fallback.querySelector('p')!.textContent = '三维界面暂时不可用，以下文章仍可直接阅读。';
      };
      import('../archive/main').then(() => { fallback.hidden = true; }).catch(error => { console.error('Archive initialization failed', error); fail(); });
    </script>
    <style is:global>
      #archive-fallback{max-width:900px;margin:40px auto;padding:28px;font:16px/1.9 MiSans,system-ui,sans-serif;color:#25271e}
      #archive-fallback a{color:inherit;text-decoration:underline}
      #archive-fallback li{margin-bottom:8px}
      body.archive-failed{overflow:auto;background:#e8e5e1}
      [hidden]{display:none!important}
    </style>
    <noscript><style>#viewport{display:none}body{margin:0;background:#e8e5e1}.archive-plain-link{display:none}</style></noscript>
  </body>
</html>
