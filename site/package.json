{
  "name": "ayakurayuki-rhine-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "check:baseline": "node scripts/check-baseline.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "astro build",
    "check:output": "node --experimental-strip-types scripts/check-output.ts",
    "preview": "node scripts/serve-dist.mjs",
    "test:browser": "playwright test",
    "verify": "npm run check:baseline && npm run check:upstream && npm test && npm run check && npm run build && npm run check:output"
  },
  "dependencies": {
    "astro": "7.3.2",
    "yaml": "2.9.0",
    "smol-toml": "1.8.0",
    "three": "0.183.2",
    "@kitlangton/rolling-number": "0.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "@types/node": "24.13.3",
    "parse5": "8.0.1",
    "mdast-util-from-markdown": "2.0.3",
    "@types/three": "0.183.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
